# ── 법제처(국가법령정보) OpenAPI ────────────────────────────────────────────
# law.go.kr 에서 발급받는 OC 키(필수). https://open.law.go.kr → OpenAPI 신청.
LAW_OC=your_law_oc_key

# ── 실무 시나리오 검색 AI 설정 ─────────────────────────────────────────────
# 사용할 AI 프로바이더 (gemini | claude | gpt)  기본값: gemini
SCENARIO_AI_PROVIDER=gemini

# 각 프로바이더의 API 키 (선택한 프로바이더에 맞는 키만 있으면 됨)
GEMINI_API_KEY=your_gemini_api_key
CLAUDE_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key

# 사용할 모델 (비우면 각 프로바이더의 기본값 사용)
SCENARIO_AI_MODEL=

# ── 서버 포트 (로컬 개발용) ──────────────────────────────────────────────
PORT=5100

# ── 내규(사규) 검색 MCP 서버 ────────────────────────────────────────────────
# 내규 검색이 연동할 외부 MCP 서버(Streamable HTTP) 엔드포인트.
# 우리 기관 내규를 서빙하는 MCP 서버 URL 을 넣으세요. 비우면 내규 검색은
# 로컬 regulations/ 파일 기반으로만 동작합니다.
SAGYU_MCP_URL=

# ── 내규 원본 PDF 저장소 (선택) ─────────────────────────────────────────────
# 원본 HWP/HWPX를 PDF로 변환해 올린 스토리지(예: Supabase Storage)의 공개 URL 접두사.
REG_PDF_BASE_URL=

# ── Gemini 선호 버전(선택) ──────────────────────────────────────────────────
# 비워 두면 계정에서 '사용 가능한 최신 모델'을 자동 선택합니다.
GEMINI_MODEL_PREF=

# ── 개정 내규 업로드(/upload) ────────────────────────────────────────────────
# 업로드 암호. 설정하면 업로드 화면에 입력란이 나타나고 이 값과 일치해야 등록됩니다.
REG_UPLOAD_TOKEN=

# 업로드분을 리포지토리에 자동 커밋해 배포에 반영(읽기전용 서버리스 대응).
# GITHUB_TOKEN: Fine-grained PAT, 해당 리포에 Contents Read and write 권한만 부여.
GITHUB_TOKEN=
GITHUB_REPO=your-org/your-repo
GITHUB_BRANCH=main

# ── 의미 검색(임베딩) ────────────────────────────────────────────────────────
# scripts/build_embeddings.py 로 생성한 regulations_vectors.{bin,json} 이 있으면
# 내규 검색에 의미 검색 결과가 함께 표시됩니다(없으면 키워드 검색만 동작).
EMBED_MODEL=text-embedding-004

# ── 보안·운영 (선택) ─────────────────────────────────────────────────────────
# CORS 허용 출처(쉼표 구분). 비우면 your-app*.vercel.app 과 localhost만 허용.
#   ALLOWED_ORIGINS=https://law.example.or.kr,https://www.example.or.kr
ALLOWED_ORIGINS=

# 디버그 엔드포인트(/api/debug/law) 노출 여부. "1"일 때만 열린다(기본 비활성).
DEBUG_ENDPOINTS=

# 콜드스타트 시 Gemini 기본 모델. 비우면 코드 내 기본값 사용.
GEMINI_MODEL=
