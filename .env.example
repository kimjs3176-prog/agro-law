# ── 법제처 API ──────────────────────────────────────────────────────────────
LAW_OC=your_law_oc_key            # 법제처 OC 키 (필수)

# ── 실무 시나리오 검색 AI 설정 ─────────────────────────────────────────────
# 사용할 AI 프로바이더 선택 (gemini | claude | gpt)  기본값: gemini
SCENARIO_AI_PROVIDER=gemini

# 각 프로바이더의 API 키 (SCENARIO_AI_PROVIDER에 맞는 키만 있으면 됨)
GEMINI_API_KEY=your_gemini_api_key
CLAUDE_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key

# 사용할 모델 (비우면 각 프로바이더의 기본값 사용)
# gemini 기본값: gemini-2.5-flash
# claude 기본값: claude-haiku-4-5-20251001
# gpt    기본값: gpt-4.1-mini
SCENARIO_AI_MODEL=

# ── 서버 포트 (로컬 개발용) ──────────────────────────────────────────────
PORT=5100

# ── 사규(내규) MCP 서버 ─────────────────────────────────────────────────────
# 내규 검색 기능이 연동할 외부 MCP 서버(Streamable HTTP) 엔드포인트
SAGYU_MCP_URL=https://tech-transfer-platform-zt79.vercel.app/mcp

# ── 내규 원본 PDF 저장소 ────────────────────────────────────────────────────
# 원본 HWP/HWPX를 PDF로 변환해 올린 스토리지(예: Supabase Storage)의 공개 URL 접두사.
# tech-transfer-platform 의 scripts/upload_regulations_pdf.py 실행 후 출력되는 값을 넣으세요.
#   예) https://xxxx.supabase.co/storage/v1/object/public/regulations/pdf
REG_PDF_BASE_URL=

# ── Gemini 선호 버전(선택) ──────────────────────────────────────────────────
# 비워 두면 계정에서 '사용 가능한 최신 모델'을 자동 선택합니다(권장, 현재 3.x 계열).
# 특정 버전으로 묶으려면 예: GEMINI_MODEL_PREF=3.0
# 전체 모델명을 강제하려면 SCENARIO_AI_MODEL 을 사용하세요.
GEMINI_MODEL_PREF=

# ── 개정 내규 업로드(/upload) ────────────────────────────────────────────────
# 업로드 암호. 설정하면 업로드 화면에 입력란이 나타나고 이 값과 일치해야 등록됩니다.
REG_UPLOAD_TOKEN=

# 업로드분을 리포지토리에 자동 커밋해 배포에 반영(읽기전용 서버리스 대응).
# GITHUB_TOKEN: Fine-grained PAT, 해당 리포에 Contents Read and write 권한만 부여
GITHUB_TOKEN=
GITHUB_REPO=kimjs3176-prog/agro-law
GITHUB_BRANCH=main

# ── 의미 검색(임베딩) ────────────────────────────────────────────────────────
# scripts/build_embeddings.py 로 생성한 regulations_vectors.{bin,json} 이 있으면
# 내규 검색에 의미 검색 결과가 함께 표시됩니다. 질의 임베딩에 Gemini 키를 사용합니다.
# (사용자 AI 설정 키가 없을 때 서버 키로 폴백)
EMBED_MODEL=text-embedding-004

# ── 보안·운영 (선택) ─────────────────────────────────────────────────────────
# CORS 허용 출처(쉼표 구분). 비우면 이 서비스의 vercel.app 도메인과 localhost만
# 허용한다. 커스텀 도메인을 쓰면 여기에 추가한다. 예)
#   ALLOWED_ORIGINS=https://law.example.or.kr,https://www.example.or.kr
ALLOWED_ORIGINS=

# 디버그 엔드포인트(/api/debug/law) 노출 여부. "1"일 때만 열린다(기본 비활성).
DEBUG_ENDPOINTS=

# 콜드스타트 시 Gemini 기본 모델(네트워크 ListModels 왕복 없이 즉시 사용).
# 비우면 코드 내 기본값을 사용한다. 특정 모델로 고정하려면 지정.
GEMINI_MODEL=
