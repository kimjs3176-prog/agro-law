# ── 법제처 API ──────────────────────────────────────────────────────────────
LAW_OC=your_law_oc_key            # 법제처 OC 키 (필수)

# ── 실무 시나리오 검색 AI 설정 ─────────────────────────────────────────────
# 사용할 AI 프로바이더 선택 (gemini | claude | gpt)  기본값: gemini
SCENARIO_AI_PROVIDER=gemini

# 각 프로바이더의 API 키 (SCENARIO_AI_PROVIDER에 맞는 키만 있으면 됨)
GEMINI_API_KEY=your_gemini_api_key
CLAUDE_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key

# 사용할 모델 (비우면 각 프로바이더의 기본값 사용)
# gemini 기본값: gemini-2.5-flash
# claude 기본값: claude-haiku-4-5-20251001
# gpt    기본값: gpt-4.1-mini
SCENARIO_AI_MODEL=

# ── 서버 포트 (로컬 개발용) ──────────────────────────────────────────────
PORT=5100

# ── 사규(내규) MCP 서버 ─────────────────────────────────────────────────────
# 내규 검색 기능이 연동할 외부 MCP 서버(Streamable HTTP) 엔드포인트
SAGYU_MCP_URL=https://tech-transfer-platform-zt79.vercel.app/mcp

# ── 내규 원본 PDF 저장소 ────────────────────────────────────────────────────
# 원본 HWP/HWPX를 PDF로 변환해 올린 스토리지(예: Supabase Storage)의 공개 URL 접두사.
# tech-transfer-platform 의 scripts/upload_regulations_pdf.py 실행 후 출력되는 값을 넣으세요.
#   예) https://xxxx.supabase.co/storage/v1/object/public/regulations/pdf
REG_PDF_BASE_URL=
